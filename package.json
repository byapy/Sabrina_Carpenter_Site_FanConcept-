{
    "name": "sabrina_carpenter_site_fanconcept-",
    "version": "1.0.0",
    "description": "This project is a fan concept website inspired by Sabrina Carpenter. So far, I have created the main page with a visual design centered around a background image, a top navigation bar, a featured message about her music, and a decorative play button.",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "build:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css",
    "dev:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css --watch"
    },
